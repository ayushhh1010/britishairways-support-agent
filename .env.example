# Pick ONE. Cerebras is the default: 1,000,000 tokens/day per model, no card.
# Get a key at https://cloud.cerebras.ai  ->  API Keys
CEREBRAS_API_KEY=

# Alternatives (set LLM_PROVIDER to match, see configs/default.yaml)
# GROQ_API_KEY=          # free but only 200k tokens/day per model
# MISTRAL_API_KEY=       # 1B tokens/month, needs phone verification

# Optional overrides
# LLM_PROVIDER=cerebras
# GEN_MODEL=gpt-oss-120b
# JUDGE_MODEL=qwen-3.8-27b
